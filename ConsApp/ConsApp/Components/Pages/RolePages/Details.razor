@page "/roles/details"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data.Consultation
@using ConsApp.Data
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext Context
@inject NavigationManager NavigationManager

<PageTitle>Role Details</PageTitle>

<h1>Role Details</h1>

@if (role is null)
{
    <p>Loading...</p>
}
else
{
    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@role.Id</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@role.Name</dd>
    </dl>

    <a href="@($"/roles/edit?id={role.Id}")" class="btn btn-primary">Edit</a>
    <a href="/roles" class="btn btn-secondary">Back</a>
}

@code {
    private Role? role;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id == 0)
        {
            NavigationManager.NavigateTo("/roles");
            return;
        }

        role = await Context.ConsultationRoles.FirstOrDefaultAsync(x => x.Id == Id);
    }
}