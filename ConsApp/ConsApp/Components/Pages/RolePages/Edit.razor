@page "/roles/edit"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data.Consultation
@using ConsApp.Data
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext Context
@inject NavigationManager NavigationManager

<PageTitle>Edit Role</PageTitle>

<h1>Edit Role</h1>

@if (role is null)
{
    <p>Loading...</p>
}
else
{
    <EditForm Model="role" OnValidSubmit="UpdateRole">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Name</label>
            <InputText class="form-control" @bind-Value="role.Name" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a href="/roles" class="btn btn-secondary">Back</a>
    </EditForm>
}

@code {
    private Role? role;

    [SupplyParameterFromQuery]
    private Guid Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id == Guid.Empty)
        {
            NavigationManager.NavigateTo("/roles");
            return;
        }

        role = await Context.ConsultationRoles.FirstOrDefaultAsync(x => x.Id == Id);
    }

    private async Task UpdateRole()
    {
        if (role is null) return;

        Context.ConsultationRoles.Update(role);
        await Context.SaveChangesAsync();

        NavigationManager.NavigateTo("/roles");
    }
}