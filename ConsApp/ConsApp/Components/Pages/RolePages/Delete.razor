@page "/roles/delete"
@attribute [ExcludeFromInteractiveRouting]
@using Abc.Data.Consultation
@using ConsApp.Data
@using Microsoft.EntityFrameworkCore

@inject ApplicationDbContext Context
@inject NavigationManager NavigationManager

<PageTitle>Delete Role</PageTitle>

<h1>Delete Role</h1>

@if (role is null)
{
    <p>Loading...</p>
}
else
{
    <p>Are you sure you want to delete this?</p>

    <dl class="row">
        <dt class="col-sm-2">Id</dt>
        <dd class="col-sm-10">@role.Id</dd>

        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@role.Name</dd>
    </dl>

    <button class="btn btn-danger" @onclick="DeleteRole">Delete</button>
    <a href="/roles" class="btn btn-secondary">Back</a>
}

@code {
    private Role? role;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Id == 0)
        {
            NavigationManager.NavigateTo("/roles");
            return;
        }

        role = await Context.ConsultationRoles.FirstOrDefaultAsync(x => x.Id == Id);
    }

    private async Task DeleteRole()
    {
        if (role is null) return;

        Context.ConsultationRoles.Remove(role);
        await Context.SaveChangesAsync();

        NavigationManager.NavigateTo("/roles");
    }
}